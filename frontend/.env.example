# The API's **origin only**. The `/api/v1` prefix is added by src/lib/api.js.
#
# The server has versioned its surface from the first release precisely so the second one can
# move it. Baking the prefix into a deployment variable would put that decision in the hands of
# whoever edits this file, and a version bump would then be a redeploy of the frontend rather
# than one edit in one module.
VITE_API_BASE_URL=http://localhost:8000

# Deliberately absent: VITE_WS_BASE_URL. There is no WebSocket surface on the API — no route,
# no handler, nothing that upgrades a connection. It described a feature that was never built.

# The Paystack *public* key, safe to ship to a browser. The secret key is the server's and is
# never read here: the webhook signature is verified server-side before the payload reaches any
# use case, and nothing in this app signs anything.
#
# Nothing reads this yet — payments are started through the API's own /billing/payment-intents
# route, and the gateway checkout is not wired up. It is kept because that is the next step.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_replace_with_real_key
