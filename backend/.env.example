DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/university_db

# Which persistence the test suite runs against. Unset means in-memory, which is the
# default everywhere and needs no database. `postgres` runs the same tests against the
# `db` service in docker-compose.yaml, and skips if it cannot be reached.
#   docker compose up -d db
#   UMS_TEST_BACKEND=postgres uv run pytest
UMS_TEST_BACKEND=memory
UMS_TEST_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ums

SECRET_KEY=change-this-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Read by src/main.py, the composition root and the only module in src/ that reads the
# environment at all. A JSON array, parsed as one.
ALLOWED_ORIGINS=["http://localhost:3000"]

# The university's register of numeric department codes, as a JSON object mapping Faculty &
# Department's alphabetic code to the four digits a matric number carries. There is deliberately
# no default: nothing in this repository has ever stated a real one, and a guess would be baked
# into every student number ever issued (CLAUDE.md section 6). A department missing from here
# cannot have students registered against it, which is the failure that gets noticed.
DEPARTMENT_NUMERIC_CODES={"CSC": "0591"}

REDIS_URL=redis://localhost:6379/0

# Required by the composition root: the webhook verifier refuses to be built without it, and
# an empty secret would verify nothing while looking exactly like verification.
PAYSTACK_SECRET_KEY=sk_test_replace_with_real_rotated_key
PAYSTACK_PUBLIC_KEY=pk_test_replace_with_real_key

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your@email.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@university.edu.ng
