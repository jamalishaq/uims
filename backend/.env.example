DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/university_db

# Which persistence the test suite runs against. Unset means in-memory, which is the
# default everywhere and needs no database. `postgres` runs the same tests against the
# `db` service in docker-compose.yaml, and skips if it cannot be reached.
#   docker compose up -d db
#   UMS_TEST_BACKEND=postgres uv run pytest
UMS_TEST_BACKEND=memory
UMS_TEST_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ums

# Required by the composition root. Signs every access and refresh token, and is the one
# secret that decides whether a token is worth anything at all.
#
# It must be **at least 32 bytes** — RFC 7518 section 3.2 for HS256 — and TokenCodec refuses to
# be built with a shorter one. A short key signs and verifies perfectly, which is exactly why a
# deployment would keep one forever, so it fails at startup instead. Generate one with:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Rotating it invalidates every token in flight, which logs everybody out. That is the intended
# behaviour and the only revocation this system has — see auth.md section 3.
JWT_SECRET_KEY=change-this-to-at-least-32-bytes-of-random

# Superseded and deliberately absent: SECRET_KEY, ALGORITHM, ACCESS_TOKEN_EXPIRE_MINUTES and
# REFRESH_TOKEN_EXPIRE_DAYS. They described an auth phase that had not been built when they were
# written, and nothing read them. The lifetimes are now constructor arguments on TokenCodec (30
# minutes and 12 hours), so a test can pick its own; the algorithm is not configurable, because
# a deployment that could choose it could choose `none`.

# Read by src/main.py, the composition root and the only module in src/ that reads the
# environment at all. A JSON array, parsed as one.
#
# It also decides one thing that is not about CORS: whether the refresh cookie carries `Secure`.
# A Secure cookie is never sent to an http:// origin, so a developer on http://localhost could
# not stay logged in with it on — and an INSECURE_COOKIES switch is one somebody eventually sets
# in production. If every origin here is http://, the flag is off. See main._cookies_require_https.
ALLOWED_ORIGINS=["http://localhost:3000"]

# The university's register of numeric department codes, as a JSON object mapping Faculty &
# Department's alphabetic code to the four digits a matric number carries. There is deliberately
# no default: nothing in this repository has ever stated a real one, and a guess would be baked
# into every student number ever issued (CLAUDE.md section 6). A department missing from here
# cannot have students registered against it, which is the failure that gets noticed.
DEPARTMENT_NUMERIC_CODES={"CSC": "0591"}

REDIS_URL=redis://localhost:6379/0

# Required by the composition root: the webhook verifier refuses to be built without it, and
# an empty secret would verify nothing while looking exactly like verification.
PAYSTACK_SECRET_KEY=sk_test_replace_with_real_rotated_key
PAYSTACK_PUBLIC_KEY=pk_test_replace_with_real_key

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your@email.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@university.edu.ng
